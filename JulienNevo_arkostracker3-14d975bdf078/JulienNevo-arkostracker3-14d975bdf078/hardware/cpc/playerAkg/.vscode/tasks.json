{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "buildRasm",
            "group": "build",
            "command": "rasm",
            "type": "shell",
            "args": [
                "-ob", "generated/main.bin",

                // Generates snapshots.
                "-sb",
                "-ss",
                "-oi", "generated/akg.sna",

                "-sw",
                "-sa",
                "-os", "generated/symbols.txt",
        
                "-twe",
        
                "-xr",
                //"sources/main.asm"
                "sources/tester/PlayerAkgTester_CPC.asm"
                //"sources/tester/PlayerAkgTester_MSX.asm"
                //"sources/tester/PlayerAkgTester_SVI.asm"
                //"sources/tester/PlayerAkgTester_PCW.asm"
                //"sources/tester/PlayerAkgTester_PENTAGON.asm"
                //"sources/tester/PlayerAkgTester_SPECTRUM.asm"
                //"sources/tester/PlayerAkgWithSoundEffectTester_CPC.asm"
                //"sources/tester/PlayerAkgWithSoundEffectTester_SPECTRUM.asm"
            ],
            "presentation": {
                "reveal": "silent",
                "clear": true,
                "showReuseMessage": false,
            },
            "problemMatcher": "$errmatcher-rasm"
        }
    ]
}